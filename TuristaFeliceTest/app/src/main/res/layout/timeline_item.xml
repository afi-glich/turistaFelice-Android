<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <androidx.cardview.widget.CardView
        android:id="@+id/timeline_item_cardview"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp"
        app:cardCornerRadius="10dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_goneMarginEnd="8dp">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="262dp"
            android:background="?attr/selectableItemBackground">

            <ImageView
                android:id="@+id/timeline_item_button_delete"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginEnd="8dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/timeline_item_title"
                app:srcCompat="@drawable/ic_delete_black_24dp" />

            <ImageView
                android:id="@+id/timeline_item_image"
                android:layout_width="0dp"
                android:layout_height="123dp"
                android:padding="0dp"
                android:scaleType="centerCrop"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:srcCompat="@drawable/image_test" />

            <TextView
                android:id="@+id/timeline_item_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:background="@color/primary"
                android:paddingStart="7dp"
                android:paddingBottom="3dp"
                android:text="@string/trip_title"
                android:textAlignment="viewStart"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold|italic"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.0"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/timeline_item_image" />

            <TextView
                android:id="@+id/timeline_item_city"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="64dp"
                android:layout_marginTop="8dp"
                android:text="@string/timeline_item_destination"
                android:textStyle="bold"
                app:layout_constraintStart_toEndOf="@+id/city_label"
                app:layout_constraintTop_toBottomOf="@+id/timeline_item_title" />

            <ImageView
                android:id="@+id/timeline_item_modify_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginEnd="8dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="@+id/timeline_item_button_delete"
                app:layout_constraintTop_toBottomOf="@+id/timeline_item_button_delete"
                app:srcCompat="@drawable/ic_edit_black_24dp" />

            <TextView
                android:id="@+id/timeline_item_departure"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/departure_date"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="@+id/timeline_item_city"
                app:layout_constraintTop_toBottomOf="@+id/timeline_item_city" />

            <TextView
                android:id="@+id/timeline_item_return"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/return_date"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="@+id/timeline_item_departure"
                app:layout_constraintTop_toBottomOf="@+id/timeline_item_departure" />

            <TextView
                android:id="@+id/city_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginTop="8dp"
                android:text="@string/timeline_item_destination"
                app:layout_constraintStart_toStartOf="@+id/timeline_item_title"
                app:layout_constraintTop_toBottomOf="@+id/timeline_item_title" />

            <TextView
                android:id="@+id/departure_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/departure_date"
                app:layout_constraintStart_toStartOf="@+id/city_label"
                app:layout_constraintTop_toBottomOf="@+id/city_label" />

            <TextView
                android:id="@+id/return_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/return_date"
                app:layout_constraintBottom_toBottomOf="@+id/timeline_item_return"
                app:layout_constraintStart_toStartOf="@+id/departure_label"
                app:layout_constraintTop_toBottomOf="@+id/departure_label" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.cardview.widget.CardView>

</androidx.constraintlayout.widget.ConstraintLayout>