<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <androidx.cardview.widget.CardView
        android:id="@+id/POI_item"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        app:cardBackgroundColor="@color/primary_light">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/imageDragAndDrop"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginRight="8dp"
                android:layout_weight="3"
                app:srcCompat="@drawable/ic_drag_handle_black_24dp" />

            <TextView
                android:id="@+id/TextViewPOI"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:textColor="@color/secondary_text"/>

            <ImageView
                android:id="@+id/image_navigate"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginLeft="8dp"
                android:layout_weight="3"
                android:contentDescription="Button to navigate to destination"
                app:srcCompat="@drawable/ic_navigation_black_24dp" />

            <ImageView
                android:id="@+id/imageDelete"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_weight="3"
                android:layout_marginLeft="8dp"
                app:srcCompat="@drawable/ic_delete_black_24dp"
                android:contentDescription="Delete POI"/>
        </LinearLayout>
    </androidx.cardview.widget.CardView>
</LinearLayout>